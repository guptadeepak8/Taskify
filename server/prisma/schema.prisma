datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  name          String?    @db.VarChar(255)
  phone         String?    @db.VarChar(20)
  address       String?    @db.Text
  business_name String?    @db.VarChar(255)
  is_verified   Boolean    @default(false)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  otps          Otp[]
  user_tasks    UserTask[]

  @@index([email], map: "users_email_idx")
  @@map("users")
}

model Otp {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  email        String   @db.VarChar(255)
  otp_hash     String   @db.VarChar(255)
  attempts     Int      @default(0)
  expires_at   DateTime @db.Timestamptz(6)
  last_sent_at DateTime @default(now()) @db.Timestamptz(6)
  is_used      Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email], map: "otps_email_idx")
  @@index([user_id], map: "otps_user_id_idx")
  @@map("otps")
}

model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(255)
  category    String     @db.VarChar(100)
  description String     @db.Text
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  user_tasks  UserTask[]

  @@index([category], map: "tasks_category_idx")
  @@map("tasks")
}

model UserTask {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  task_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([user_id, task_id], map: "user_tasks_user_id_task_id_unique")
  @@index([user_id], map: "user_tasks_user_id_idx")
  @@map("user_tasks")
}
